{
  "name": "@cinepixo/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./password": "./src/password.ts",
    "./errors": "./src/errors.ts",
    "./people-link": "./src/people-link.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "deploy": "prisma migrate deploy",
    "status": "prisma migrate status",
    "audit-library": "tsx prisma/audit-library.ts",
    "seed": "tsx prisma/seed.ts",
