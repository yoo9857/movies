    "seed:current": "tsx prisma/seed-current-movies.ts",
    "seed:topics": "tsx prisma/seed-topics.ts",
    "add-films": "tsx prisma/add-films.ts",
    "import-wikidata": "tsx prisma/import-wikidata.ts",
    "import-curated": "tsx prisma/import-curated-movies.ts",
    "import-wikidata-credits": "tsx prisma/import-wikidata-credits.ts",
    "import-wikidata-people": "tsx prisma/import-wikidata-people.ts",
    "import-wikidata-details": "tsx prisma/import-wikidata-details.ts",
