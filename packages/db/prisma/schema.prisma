generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "sqlite"
}

// Fan account. Reviews are written by users; the site owner is role=ADMIN.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  // scrypt hash, format: scrypt$N$r$p$salt$hash (never store plaintext)
  passwordHash String
  // "ADMIN" | "MEMBER" (SQLite has no enums — validated with zod at the app layer)
  role         String   @default("MEMBER")
  displayName  String?
  bio          String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  reviews      Review[]
}

// A professional film critic the fandom follows — profile directory.
model Critic {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  bio       String?
  avatarUrl String?
  // JSON string: [{ "label": "YouTube", "url": "..." }]
  links     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A film — imported from TMDB or added manually.
model Movie {
  id            String    @id @default(cuid())
  tmdbId        Int?      @unique
  imdbId        String?
  title         String
  originalTitle String?
  tagline       String?
  overview      String?
  posterPath    String?
  backdropPath  String?
  releaseDate   DateTime?
  runtime       Int?
  director      String?
  // JSON string: ["Drama", "Thriller"]
  genres        String?
  // JSON string: ["class", "black comedy"]
  keywords      String?
  // JSON string: ["South Korea"]
  countries     String?
  // US certification, e.g. "R", "PG-13"
  certification String?
  // USD — Float so >2^31 revenues (Avatar) fit without BigInt JSON issues
  budget        Float?
  revenue       Float?
  voteAverage   Float?
  voteCount     Int?
  popularity    Float?
  // YouTube key of the primary trailer (the rest live in MovieVideo)
  trailerKey    String?
  // Franchise / series this film belongs to
  collectionId   Int?
  collectionName String?
  // JSON string: [{ "name": "Barunson E&A", "logoPath": "/x.png" }]
  companies      String?
  // Official presence
  homepage       String?
  instagram      String?
  facebook       String?
  twitter        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  reviews       Review[]
  cast          MovieCast[]
  crew          MovieCrew[]
  videos        MovieVideo[]
  images        MovieImage[]

  @@index([title])
  @@index([collectionId])
}

// Trailers, teasers and clips — so a film with several gets a picker.
model MovieVideo {
  id          String   @id @default(cuid())
  movieId     String
  movie       Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  youtubeKey  String
  name        String
  type        String   // "Trailer" | "Teaser" | "Clip" | "Featurette"
  official    Boolean  @default(false)
  publishedAt DateTime?
  sort        Int      @default(0)

  @@unique([movieId, youtubeKey])
  @@index([movieId, sort])
}

// Alternate posters and stills for the gallery.
model MovieImage {
  id      String  @id @default(cuid())
  movieId String
  movie   Movie   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  // "poster" | "backdrop"
  kind    String
  path    String
  // ISO 639-1 language of any burned-in title text, when TMDB reports one
  lang    String?
  sort    Int     @default(0)

  @@unique([movieId, path])
  @@index([movieId, kind, sort])
}

// Top-billed cast, in TMDB billing order.
model MovieCast {
  id           String  @id @default(cuid())
  movieId      String
  movie        Movie   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  tmdbPersonId Int
  name         String
  character    String?
  profilePath  String?
  order        Int

  @@index([movieId, order])
}

// Key crew: Director, Screenplay, Director of Photography, Composer, Editor…
model MovieCrew {
  id           String  @id @default(cuid())
  movieId      String
  movie        Movie   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  tmdbPersonId Int
  name         String
  job          String
  department   String?
  profilePath  String?

  @@index([movieId])
}

// A fan-written review of a movie.
model Review {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?
  // Markdown body — rendered with raw HTML disabled (XSS prevention)
  content     String
  // 0.0–10.0 in 0.5 steps — displayed as a 5-star scale
  rating      Float
  // "DRAFT" | "PUBLISHED" (validated with zod at the app layer)
  status      String    @default("DRAFT")
  publishedAt DateTime?
  viewCount   Int       @default(0)
  authorId    String
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  movieId     String
  movie       Movie     @relation(fields: [movieId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, publishedAt(sort: Desc)])
  @@index([authorId])
  @@index([movieId])
}
