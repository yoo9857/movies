// CinePixo — PostgreSQL schema.
//
// Choices worth knowing:
//  · state columns are real enums, so an invalid status cannot be written even
//    by a raw query or a bad migration
//  · list columns are native text[] rather than JSON strings, so filtering by
//    genre is a database query instead of loading the table into memory
//  · every timestamp is timestamptz — a Date without a zone is a bug waiting
//    for the first server that isn't UTC
//  · ratings and counters carry CHECK constraints, added in the migration SQL
//    that Prisma cannot express (see migrations/*_constraints)

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MEMBER
}

enum ReviewStatus {
  DRAFT
  PUBLISHED
}

enum SpoilerLevel {
  NONE
  MILD
  FULL
}

enum ImageKind {
  poster
  backdrop
}

enum TopicKind {
  THEME
  MOTIF
}

/// Fan account. Reviews are written by users; the site owner is role=ADMIN.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  /// scrypt hash, format: scrypt$N$r$p$salt$hash (never store plaintext)
  passwordHash String
  role         UserRole @default(MEMBER)
  displayName  String?
  bio          String?
  avatarUrl    String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  reviews      Review[]
  votes        ReviewVote[]
}

/// A professional film critic the fandom follows — profile directory.
model Critic {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  bio       String?
  avatarUrl String?
  /// Credit for `avatarUrl` when it came from Commons — a free licence's
  /// terms travel with the file, and a licence without a source is refused.
  avatarCredit     String?
  avatarLicense    String?
  avatarLicenseUrl String?
  avatarSourceUrl  String?
  /// [{ "label": "YouTube", "url": "..." }]
  links     Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([name])
}

/// A film — imported from TMDB or added manually.
model Movie {
  id            String    @id @default(cuid())
  /// URL identity: title-year ("parasite-2019"). The id stays the relational
  /// key; the slug is what appears in every public URL. Old id URLs 301 here.
  slug          String    @unique
  tmdbId        Int?      @unique
  /// Wikidata item id ("Q47703"), for films imported without a TMDB credential.
  /// The provenance of every fact on those rows, and the key their import is
  /// idempotent on — a title and a year are not unique enough to be one.
  wikidataId    String?   @unique
  /// How many Wikipedia editions have an article on this film. The notability
  /// signal every backfill works through, so the library fills in the order
  /// that matters rather than alphabetically.
  wikidataSitelinks Int?
  imdbId        String?
  title         String
  originalTitle String?
  tagline       String?
  overview      String?
  /// Where the synopsis came from and under what terms. TMDB rows leave these
  /// null (the site-wide TMDB notice covers them); a Wikipedia synopsis is
  /// CC BY-SA and must carry its article and licence, which a CHECK enforces.
  overviewSourceUrl String?
  overviewLicense   String?
  /// The article about the film, for the sources line and for re-enrichment.
  wikipediaUrl  String?
  /// ISO-ish label of the original language ("Japanese"), for JSON-LD's
  /// inLanguage — which was left empty rather than asserting "en" for everything.
  originalLanguage String?
  /// TMDB's paths — a source their CDN completes, never something we host.
  posterPath    String?
  backdropPath  String?
  /// Artwork on our own storage: a real, freely licensed poster or still, fetched
  /// once and re-encoded. Preferred over posterPath wherever a poster is shown.
  /// The credit columns are not decoration — a free licence requires them, and a
  /// CHECK constraint refuses a file without a source URL.
  image           String?
  imageCredit     String?
  imageLicense    String?
  imageLicenseUrl String?
  imageSourceUrl  String?
  releaseDate   DateTime? @db.Date
  runtime       Int?
  director      String?
  genres        String[]
  keywords      String[]
  countries     String[]
  /// US certification, e.g. "R", "PG-13"
  certification String?
  /// USD. Float because a revenue over 2^31 must not overflow.
  budget        Float?
  revenue       Float?
  voteAverage   Float?
  voteCount     Int?
  popularity    Float?
  /// YouTube key of the primary trailer (the rest live in MovieVideo)
  trailerKey    String?
  /// A trailer file on storage we own — local path or our Linode bucket —
  /// played by our own <video>: no rented player, no third-party chrome.
  /// The CHECK names our bucket host exactly; anything else is a hotlink.
  trailerFile   String?
  /// Terms for `trailerFile` when it came from Commons rather than an operator.
  /// Licence and source are refused apart; duration is seconds.
  trailerFileCredit     String?
  trailerFileLicense    String?
  trailerFileLicenseUrl String?
  trailerFileSourceUrl  String?
  trailerFileDuration   Int?
  /// The complete film, when it is free (Wikidata P10 → Commons). Our copy on
  /// our storage, never a hotlink — same CHECK as `trailerFile`. Deliberately
  /// not that column: a trailer advertises a film, this *is* the film.
  /// The licence and its source are refused apart; duration is seconds.
  filmFile           String?
  filmFileCredit     String?
  filmFileLicense    String?
  filmFileLicenseUrl String?
  filmFileSourceUrl  String?
  filmFileDuration   Int?
  collectionId   Int?
  collectionName String?
  /// [{ "name": "Barunson E&A", "logoPath": "/x.png" }]
  companies      Json?
  homepage       String?
  instagram      String?
  facebook       String?
  twitter        String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  reviews       Review[]
  cast          MovieCast[]
  crew          MovieCrew[]
  videos        MovieVideo[]
  images        MovieImage[]
  topics        MovieTopic[]

  @@index([title])
  @@index([collectionId])
  /// list ordering and filtering
  @@index([releaseDate(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([voteAverage(sort: Desc)])
  /// genre filters use the array containment operator — GIN is the right index
  @@index([genres], type: Gin)
}

/// A person — actor, director, writer — as an entity this site owns.
///
/// Cast and crew used to be loose rows carrying a name and a TMDB path, so the
/// same actor across five films was five unconnected records with nowhere to
/// put a photo, a biography, or anything we had written. A Person is the row
/// those credits point at: one identity, one page, one place for our own
/// research.
///
/// `image` is deliberately *our* URL — an object on our storage that went
/// through our upload pipeline — not a TMDB hotlink. `tmdbProfilePath` is kept
/// only as the seed a first import can pull from; once `image` is set it is the
/// one that renders.
model Person {
  id      String  @id @default(cuid())
  /// URL identity: "song-kang-ho". Old ids never appear in public URLs.
  slug    String  @unique
  name    String
  /// Optional link to TMDB, for enrichment. Null for people we added ourselves.
  tmdbId  Int?    @unique
  /// Our own portrait, served from our origin. Null renders house initials.
  image   String?
  /// TMDB's profile path — a source to import from, never what the page shows.
  tmdbProfilePath String?

  /// ── Everything below is ours to write ──
  /// Who they are, in our words. Never filled from an encyclopedia: the facts
  /// below can be imported, the prose is the site.
  bio       String?
  /// Career notes, recurring collaborators, what to watch first.
  notes     String?
  birthDate DateTime? @db.Date
  deathDate DateTime? @db.Date
  birthPlace String?
  /// Occupations as labels ("film director", "screenwriter"), from Wikidata.
  occupations String[]
  /// Off-site profiles for schema.org sameAs — identity claims, so real ones only.
  links     Json?

  /// ── Provenance ──
  /// Wikidata Q-id and the Wikipedia article, when we have matched them. These
  /// make a later re-enrichment unambiguous and give the page real sources.
  wikidataId   String? @unique
  wikipediaUrl String?
  imdbId       String?
  /// Credit for `image`, carried because a Commons photo is licensed, not free
  /// of obligation. Shown on the page; an image with no credit is a claim we
  /// cannot back.
  imageCredit     String?
  imageLicense    String?
  imageLicenseUrl String?
  imageSourceUrl  String?

  castRoles MovieCast[]
  crewRoles MovieCrew[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([name])
}

/// Top-billed cast, in TMDB billing order.
model MovieCast {
  id           String  @id @default(cuid())
  movieId      String
  movie        Movie   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  /// The person this credit is for. Set for every row the backfill matched;
  /// nullable so a hand-added credit can exist before its Person does.
  personId     String?
  person       Person? @relation(fields: [personId], references: [id], onDelete: SetNull)
  /// Whichever source this credit came from identifies it. TMDB imports carry
  /// the numeric id; Wikidata imports carry the Q-id. Neither is required.
  tmdbPersonId Int?
  wikidataPersonId String?
  name         String
  character    String?
  profilePath  String?
  order        Int

  @@index([movieId, order])
  @@index([name])
  @@index([personId])
  @@index([wikidataPersonId])
}

/// Key crew: Director, Screenplay, Director of Photography, Composer, Editor…
model MovieCrew {
  id           String  @id @default(cuid())
  movieId      String
  movie        Movie   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  personId     String?
  person       Person? @relation(fields: [personId], references: [id], onDelete: SetNull)
  tmdbPersonId Int?
  wikidataPersonId String?
  name         String
  job          String
  department   String?
  profilePath  String?

  @@index([movieId])
  @@index([name])
  @@index([personId])
  @@index([wikidataPersonId])
}

/// Trailers, teasers and clips — so a film with several gets a picker.
model MovieVideo {
  id          String    @id @default(cuid())
  movieId     String
  movie       Movie     @relation(fields: [movieId], references: [id], onDelete: Cascade)
  youtubeKey  String
  name        String
  /// "Trailer" | "Teaser" | "Clip" | "Featurette" — free text by design, TMDB
  /// adds new kinds and an unknown one must not fail an import
  type        String
  official    Boolean   @default(false)
  publishedAt DateTime? @db.Timestamptz(3)
  sort        Int       @default(0)

  @@unique([movieId, youtubeKey])
  @@index([movieId, sort])
}

/// Alternate posters and stills for the gallery.
model MovieImage {
  id      String    @id @default(cuid())
  movieId String
  movie   Movie     @relation(fields: [movieId], references: [id], onDelete: Cascade)
  kind    ImageKind
  path    String
  /// ISO 639-1 language of any burned-in title text, when TMDB reports one
  lang    String?
  sort    Int       @default(0)

  @@unique([movieId, path])
  @@index([movieId, kind, sort])
}

/// An editorial axis of the library — a theme (what a film is about: class
/// divide, the cost of ambition) or a motif (what recurs on screen: stairs,
/// mirrors, one continuous take).
///
/// This is curation, not import: TMDB keywords describe a film in isolation,
/// a topic connects films to each other in our voice. Nothing here is ever
/// filled from an API — the taxonomy, the definitions and every per-film note
/// are written by us, which is the point of having one.
model Topic {
  id   String    @id @default(cuid())
  /// URL identity: "class-divide". Same slug grammar as every public URL.
  slug String    @unique
  name String
  kind TopicKind
  /// One-sentence definition of the axis, shown on cards and in dt/dd lists.
  description String?
  /// The editorial essay: why this axis matters, how to read it, what to
  /// watch first. Markdown, ours.
  essay String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  movies    MovieTopic[]

  @@index([kind])
  @@index([name])
}

/// One film carrying one topic, with the sentence that justifies the claim.
model MovieTopic {
  movieId String
  movie   Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  /// How the theme or motif shows up in *this* film — one editorial sentence.
  /// A topic page listing films without saying why is just a tag cloud.
  note      String?
  /// Curated position within the topic, 0-based. Not derived from createdAt:
  /// the admin screen rewrites the whole list in one transaction, and now() is
  /// transaction-scoped, so every row would share a timestamp.
  sort      Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([movieId, topicId])
  @@index([topicId])
  @@index([topicId, sort])
}

/// A fan-written review of a movie.
model Review {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  excerpt     String?
  /// Conclusion-first: the one-line takeaway, shown before the body
  verdict     String?
  /// Markdown body — rendered with raw HTML disabled (XSS prevention)
  content     String
  /// 0.0–10.0 in 0.5 steps — displayed as a 5-star scale. Range and step are
  /// enforced by a CHECK constraint as well as by zod.
  rating      Float
  status      ReviewStatus @default(DRAFT)
  spoilers    SpoilerLevel @default(NONE)
  publishedAt DateTime?    @db.Timestamptz(3)
  viewCount   Int          @default(0)
  helpfulCount Int         @default(0)
  authorId    String
  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  movieId     String
  movie       Movie        @relation(fields: [movieId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)
  votes       ReviewVote[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([authorId, updatedAt(sort: Desc)])
  @@index([movieId, status])
  @@index([status, helpfulCount(sort: Desc)])
}

/// "This review was useful" — one per member per review. The denormalised
/// counter on Review keeps list sorting cheap.
model ReviewVote {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([reviewId, userId])
  @@index([userId])
}
