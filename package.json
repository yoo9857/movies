{
  "name": "cinepixo",
  "version": "0.1.0",
  "private": true,
  "description": "CinePixo — 영화평론가 팬사이트",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:db": "vitest run --project db",
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "start": "npm run start -w web",
    "lint": "npm run lint -w web",
    "db:generate": "npm run generate -w @cinepixo/db",
    "db:migrate": "npm run migrate -w @cinepixo/db",
    "db:seed": "npm run seed -w @cinepixo/db",
    "db:seed:library": "npm run seed:library -w @cinepixo/db",
    "db:seed:current": "npm run seed:current -w @cinepixo/db",
    "db:seed:topics": "npm run seed:topics -w @cinepixo/db",
    "//args": "The trailing `--` on the next three matters: without it npm eats the flags after `npm run db:x -- --limit=5` as its own instead of handing them to the script, so an importer silently ran with its defaults.",
    "db:add-films": "npm run add-films -w @cinepixo/db --",
    "db:import-wikidata": "npm run import-wikidata -w @cinepixo/db --",
    "db:import-curated": "npm run import-curated -w @cinepixo/db --",
    "db:import-wikidata-credits": "npm run import-wikidata-credits -w @cinepixo/db --",
    "db:import-wikidata-people": "npm run import-wikidata-people -w @cinepixo/db --",
    "db:import-wikidata-details": "npm run import-wikidata-details -w @cinepixo/db --",
    "db:write-reviews": "npm run write-reviews -w @cinepixo/db --",
    "db:write-posts": "npm run write-posts -w @cinepixo/db --",
    "db:import-sitelinks": "npm run import-wikidata-sitelinks -w @cinepixo/db --",
    "db:person-notes": "npm run person-notes -w @cinepixo/db --",
    "db:migrate-uploads": "npm run migrate-uploads -w @cinepixo/db --",
    "db:import-trailers": "npm run import-trailers -w @cinepixo/db --",
    "db:import-site-trailers": "npm run import-site-trailers -w @cinepixo/db --",
    "portraits": "npm run portraits -w web --",
    "artwork": "npm run artwork -w web --",
    "posters": "npm run posters -w web --",
    "free-films": "npm run free-films -w web --",
    "post-images": "npm run post-images -w web --",
    "person-photos": "npm run person-photos -w web --",
    "topic": "npm run topic -w web --",
    "publish": "npm run publish -w web --",
    "publish-post": "npm run publish-post -w web --",
    "blog-doctor": "npm run blog-doctor -w web --",
    "deploy-check": "npm run deploy-check -w web --",
    "save-media": "npm run save-media -w web --",
    "db:refresh-library": "npm run refresh-library -w @cinepixo/db",
    "db:studio": "npm run studio -w @cinepixo/db",
    "db:deploy": "npm run deploy -w @cinepixo/db",
    "db:status": "npm run status -w @cinepixo/db",
    "db:audit-library": "npm run audit-library -w @cinepixo/db"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "postcss": "^8.5.24",
    "sharp": "^0.35.3",
    "minimatch": "^10.2.6",
    "fast-uri": "^3.1.5",
    "js-yaml": "^4.3.1"
  },
  "devDependencies": {
    "brace-expansion": "5.0.9",
    "jsdom": "^30.0.1",
    "vitest": "^4.1.10"
  }
}
