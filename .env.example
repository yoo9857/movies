# Copy to apps/web/.env.local and fill in real values. NEVER commit real secrets.

# 64+ random bytes, base64 — signs session JWTs
SESSION_SECRET=

# TMDB credentials — https://www.themoviedb.org/settings/api hands out both.
# Set ONE of these; the v4 Read Access Token is TMDB's current default and is
# preferred when both are present.
# TMDB_ACCESS_TOKEN=
TMDB_API_KEY=

# Canonical origin, no trailing slash — e.g. https://cinepixo.com
#
# REQUIRED IN PRODUCTION — a production build without it fails on purpose, see
# apps/web/src/lib/site.ts. Every canonical URL, Open Graph URL, sitemap entry,
# feed link and JSON-LD @id is built from this value, and NEXT_PUBLIC_* is inlined
# at build time, so a bundle built without it ships "localhost" as the site's
# declared home. That is invisible in the built output and the one SEO mistake
# that undoes every other one being right.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Search-console ownership tokens. Optional: each emits a verification meta tag
# only when set, so an unverified deploy carries none.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=
# NEXT_PUBLIC_YANDEX_SITE_VERIFICATION=

# AdSense publisher id (ca-pub-…). One switch for the whole feature: the
# google-adsense-account meta tag, /ads.txt, the loader script, and the parts of
# the CSP that admit an ad frame. Unset means no ads and a policy with no Google
# in it and no eval anywhere.
# NEXT_PUBLIC_GOOGLE_ADSENSE_ACCOUNT=
# Ad unit id for the review page's right-hand rail (digits from the AdSense
# dashboard). Without it the rail renders contents only.
# NEXT_PUBLIC_ADSENSE_SLOT_RAIL=

# PostgreSQL connection string (required).
# Local development tunnels to the server's database:
#   ssh -N -L 5435:127.0.0.1:5435 oneday-server
# then use 127.0.0.1:5435 below. On the server, use 127.0.0.1:5435 directly.
DATABASE_URL=postgresql://cinepixo:PASSWORD@127.0.0.1:5435/cinepixo?schema=public

# Connection pool ceiling. One app process against a shared 60-connection
# server — see ops/postgres/README.md before raising it.
# DATABASE_POOL_MAX=10

# Seed-time admin credentials (packages/db/prisma/seed.ts).
# If unset, a random password is generated and printed once.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# ── Uploads ──────────────────────────────────────────────────────
# Left unset, uploads are written to var/uploads/ on this machine and served
# from /uploads/*. That is fine for one server; set these to move them to
# object storage (Linode Object Storage, S3, R2 — anything S3-compatible).
# S3_ENDPOINT=https://us-lax-1.linodeobjects.com
# S3_REGION=us-lax-1
# S3_BUCKET=cinepixo
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_URL=https://cinepixo.us-lax-1.linodeobjects.com

# Override where the local driver writes.
# UPLOAD_DIR=/srv/cinepixo/uploads
