# Copy to apps/web/.env.local and fill in real values. NEVER commit real secrets.

# 64+ random bytes, base64 — signs session JWTs
SESSION_SECRET=

# TMDB API key (v3) — https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Canonical site URL for SEO (sitemap/OG/RSS) — e.g. https://cinepixo.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: override the SQLite location / point to Postgres in production
# DATABASE_URL=

# Seed-time admin credentials (packages/db/prisma/seed.ts).
# If unset, a random password is generated and printed once.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
